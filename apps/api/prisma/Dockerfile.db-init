FROM node:22-alpine

RUN apk add --no-cache postgresql-client

WORKDIR /app

COPY apps/api/prisma ./prisma
RUN npm install prisma@6 --no-save

COPY apps/api/prisma/init-db.sh ./init-db.sh
RUN chmod +x ./init-db.sh

ENV DATABASE_URL=postgresql://postgres:password@postgres:5432/diagrams_db?schema=public

ENTRYPOINT ["./init-db.sh"]
